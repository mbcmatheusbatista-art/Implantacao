# Sem chaves de API externas necessárias.
# Rotas são calculadas de forma aproximada (gratuita) via Photon/komoot + haversine.
# Rota real no mapa usa o OSRM público (router.project-osrm.org), sem chave.

# Chave gratuita do Stadia Maps (https://stadiamaps.com) para os tiles do mapa.
# Opcional: sem ela os tiles continuam funcionando (plano gratuito sem chave).
VITE_STADIA_MAPS_API_KEY=

# Provedor de rota do mapa. Opções:
#   osrm   (padrão): servidor público OSRM, gratuito e sem chave;
#   stadia: Valhalla da Stadia Maps (exige VITE_STADIA_MAPS_API_KEY).
# Se "stadia" falhar, o app usa o OSRM como fallback automaticamente.
VITE_ROUTE_PROVIDER=

# Supabase (https://supabase.com) — cadastro de técnicos com endereço e CNPJ.
# Sem estas chaves o cadastro funciona localmente (sem persistir no banco).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

